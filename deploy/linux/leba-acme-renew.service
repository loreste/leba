[Unit]
Description=Leba ACME certificate renew (lego via admin API)
After=network-online.target leba.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/leba/leba.env
# Expect LEBA_ADMIN_AUTH=user:pass and optional LEBA_ADMIN_URL
# Default admin bind in deploy/linux/leba.conf is :18404 (Docker demo uses :8404).
ExecStart=/usr/bin/curl -fsS -u "${LEBA_ADMIN_AUTH}" -X POST \
  "${LEBA_ADMIN_URL:-http://127.0.0.1:18404}/admin/certificates/renew"
# Renew API sets tls_reload; optional explicit reload:
# ExecStartPost=/usr/bin/curl -fsS -u "${LEBA_ADMIN_AUTH}" -X POST \
#   "${LEBA_ADMIN_URL:-http://127.0.0.1:18404}/admin/tls-reload"

[Install]
WantedBy=multi-user.target
