// Native ACME integration for Let's Encrypt-compatible providers.
// Core issue/renew is Mako-native: HTTPS client + ES256 JWS + P-256 account key.
// External helpers are legacy compatibility only.
pack acme

// Official Let's Encrypt ACME v2 directories (RFC 8555).
fn acme_le_production_directory() -> string {
    return "https://acme-v02.api.letsencrypt.org/directory"
}

fn acme_le_staging_directory() -> string {
    return "https://acme-staging-v02.api.letsencrypt.org/directory"
}

struct AcmeSettings {
    webroot: string
    storage: string
    email: string
    helper: string
    // ACME directory URL. Empty → Let's Encrypt production (native default).
    server: string
    // 1 = use LE staging directory (rate-limit safe for testing).
    staging: int
}

struct AcmeRunResult {
    ok: int
    error: string
    cert: string
    key: string
    domain: string
    output: string
}

// Reject shell metacharacters in tokens used inside exec_run strings.
fn acme_token_safe(s: string) -> int {
    if str_eq(s, "") {
        return 0
    }
    if str_len(s) > 256 {
        return 0
    }
    let data = bytes(s)
    for _, d in range data {
        let c = int(d)
        let mut ok = 0
        if c >= 48 {
            if c <= 57 {
                ok = 1
            }
        }
        if c >= 65 {
            if c <= 90 {
                ok = 1
            }
        }
        if c >= 97 {
            if c <= 122 {
                ok = 1
            }
        }
        if c == 45 {
            ok = 1
        }
        if c == 46 {
            ok = 1
        }
        if c == 95 {
            ok = 1
        }
        if c == 64 {
            ok = 1
        }
        if c == 43 {
            ok = 1
        }
        if c == 47 {
            ok = 1
        }
        if ok == 0 {
            return 0
        }
    }
    return 1
}

fn acme_email_ok(s: string) -> int {
    if acme_token_safe(s) == 0 {
        return 0
    }
    if not str_contains(s, "@") {
        return 0
    }
    if str_contains(s, "..") {
        return 0
    }
    return 1
}

// ACME directory URLs: allow https://host/path only (no shell metacharacters).
fn acme_server_ok(s: string) -> int {
    if str_eq(s, "") {
        return 1
    }
    if str_len(s) > 256 {
        return 0
    }
    if not str_has_prefix(s, "https://") {
        return 0
    }
    let data = bytes(s)
    for _, d in range data {
        let c = int(d)
        let mut ok = 0
        if c >= 48 {
            if c <= 57 {
                ok = 1
            }
        }
        if c >= 65 {
            if c <= 90 {
                ok = 1
            }
        }
        if c >= 97 {
            if c <= 122 {
                ok = 1
            }
        }
        // : / . - _ ~
        if c == 58 {
            ok = 1
        }
        if c == 47 {
            ok = 1
        }
        if c == 46 {
            ok = 1
        }
        if c == 45 {
            ok = 1
        }
        if c == 95 {
            ok = 1
        }
        if c == 126 {
            ok = 1
        }
        if ok == 0 {
            return 0
        }
    }
    return 1
}

// Resolve effective ACME directory URL for native ACME and legacy helpers.
fn acme_effective_server(settings: AcmeSettings) -> string {
    if settings.staging == 1 {
        return acme_le_staging_directory()
    }
    if not str_eq(settings.server, "") {
        return settings.server
    }
    // Empty server -> Let's Encrypt production; return explicit URL for logs/API.
    return acme_le_production_directory()
}

// Append " --server URL" when a directory is configured (always for LE branding).
fn acme_append_server_flag(cmd: string, settings: AcmeSettings) -> string {
    let server = acme_effective_server(settings)
    if acme_server_ok(server) == 0 {
        return cmd
    }
    let mut b = str_builder()
    builder_write(b, cmd)
    builder_write(b, " --server ")
    builder_write(b, server)
    return builder_string(b)
}

fn acme_ca_name(settings: AcmeSettings) -> string {
    let server = acme_effective_server(settings)
    if str_contains(server, "staging") {
        return "letsencrypt-staging"
    }
    if str_contains(server, "letsencrypt.org") {
        return "letsencrypt"
    }
    return "custom"
}

fn acme_bool_env(name: string) -> int {
    let v = env_get(name)
    if str_eq(v, "1") or str_eq(v, "true") or str_eq(v, "on") or str_eq(v, "yes") {
        return 1
    }
    return 0
}

fn acme_kv_from_config(config_path: string, key: string) -> string {
    if str_eq(config_path, "") {
        return ""
    }
    let raw = read_file(config_path)
    if str_eq(raw, "") {
        return ""
    }
    let lines = str_split(raw, "\n")
    for _, line in range lines {
        let t = str_trim_space(line)
        if str_has_prefix(t, "#") {
            continue
        }
        let fields = str_fields(t)
        if len(fields) >= 2 {
            if str_eq(fields[0], key) {
                return expand_env(fields[1])
            }
        }
    }
    return ""
}

fn acme_settings_resolve(webroot_hint: string) -> AcmeSettings {
    return acme_settings_resolve_path(webroot_hint, "")
}

fn acme_settings_resolve_path(webroot_hint: string, config_path: string) -> AcmeSettings {
    let mut webroot = webroot_hint
    if str_eq(webroot, "") {
        webroot = env_get_or("LEBA_ACME_WEBROOT", "")
    }
    if str_eq(webroot, "") {
        webroot = acme_kv_from_config(config_path, "acme_webroot")
    }
    if str_eq(webroot, "") {
        webroot = "/var/lib/leba/acme"
    }
    let mut storage = env_get_or("LEBA_ACME_STORAGE", "")
    if str_eq(storage, "") {
        storage = acme_kv_from_config(config_path, "acme_storage")
    }
    if str_eq(storage, "") {
        storage = "/var/lib/leba/acme-state"
    }
    let mut email = env_get_or("LEBA_ACME_EMAIL", "")
    if str_eq(email, "") {
        email = acme_kv_from_config(config_path, "acme_email")
    }
    let mut helper = env_get_or("LEBA_ACME_HELPER", "")
    if str_eq(helper, "") {
        helper = acme_kv_from_config(config_path, "acme_helper")
    }
    if str_eq(helper, "") {
        helper = "native"
    }
    let mut server = env_get_or("LEBA_ACME_SERVER", "")
    if str_eq(server, "") {
        server = acme_kv_from_config(config_path, "acme_server")
    }
    let mut staging = acme_bool_env("LEBA_ACME_STAGING")
    if staging == 0 {
        let st = acme_kv_from_config(config_path, "acme_staging")
        if str_eq(st, "on") or str_eq(st, "1") or str_eq(st, "true") or str_eq(st, "yes") {
            staging = 1
        }
    }
    // Convenience aliases for server.
    if str_eq(server, "staging") or str_eq(server, "le-staging") or str_eq(server, "letsencrypt-staging") {
        staging = 1
        server = ""
    }
    if str_eq(server, "production") or str_eq(server, "le") or str_eq(server, "letsencrypt") {
        staging = 0
        server = ""
    }
    return AcmeSettings {
        webroot: webroot,
        storage: storage,
        email: email,
        helper: helper,
        server: server,
        staging: staging
    }
}

fn acme_settings_from_defaults(d: Defaults, webroot_hint: string) -> AcmeSettings {
    let mut s = acme_settings_resolve(webroot_hint)
    if not str_eq(d.acme_webroot, "") {
        if str_eq(webroot_hint, "") {
            s.webroot = d.acme_webroot
        }
    }
    if not str_eq(d.acme_storage, "") {
        s.storage = d.acme_storage
    }
    if not str_eq(d.acme_email, "") {
        s.email = d.acme_email
    }
    if not str_eq(d.acme_helper, "") {
        s.helper = d.acme_helper
    }
    if not str_eq(d.acme_server, "") {
        s.server = d.acme_server
    }
    if d.acme_staging == 1 {
        s.staging = 1
    }
    // Env still wins for operator overrides when set.
    let env_email = env_get("LEBA_ACME_EMAIL")
    if not str_eq(env_email, "") {
        s.email = env_email
    }
    let env_storage = env_get("LEBA_ACME_STORAGE")
    if not str_eq(env_storage, "") {
        s.storage = env_storage
    }
    let env_helper = env_get("LEBA_ACME_HELPER")
    if not str_eq(env_helper, "") {
        s.helper = env_helper
    }
    let env_web = env_get("LEBA_ACME_WEBROOT")
    if not str_eq(env_web, "") {
        s.webroot = env_web
    }
    let env_server = env_get("LEBA_ACME_SERVER")
    if not str_eq(env_server, "") {
        s.server = env_server
    }
    if acme_bool_env("LEBA_ACME_STAGING") == 1 {
        s.staging = 1
    }
    return s
}

// Apply query overrides (staging=1 / server=) for a single API call.
fn acme_settings_apply_query(settings: AcmeSettings, staging_q: string, server_q: string) -> AcmeSettings {
    let mut s = settings
    if str_eq(staging_q, "1") or str_eq(staging_q, "true") or str_eq(staging_q, "on") {
        s.staging = 1
    }
    if str_eq(staging_q, "0") or str_eq(staging_q, "false") or str_eq(staging_q, "off") {
        s.staging = 0
    }
    if not str_eq(server_q, "") {
        if acme_server_ok(server_q) == 1 {
            s.server = server_q
            s.staging = 0
        }
    }
    return s
}

fn acme_first_webroot(frontends: []Frontend) -> string {
    for _, fe in range frontends {
        if not str_eq(fe.acme_webroot, "") {
            return fe.acme_webroot
        }
    }
    return ""
}

// Native ACME stores PEMs as <storage>/certificates/<domain>.crt and .key
fn acme_cert_paths(storage: string, domain: string) -> (string, string) {
    let base = storage + "/certificates/" + domain
    return (base + ".crt", base + ".key")
}

fn acme_paths_exist(cert: string, key: string) -> int {
    if file_exists(cert) {
        if file_exists(key) {
            return 1
        }
    }
    return 0
}

fn acme_helper_available(helper: string) -> int {
    if str_eq(helper, "") {
        return 0
    }
    if acme_token_safe(helper) == 0 {
        return 0
    }
    if file_exists(helper) {
        return 1
    }
    // command -v is shell; helper is token-safe.
    let probe = exec_output("command -v " + helper + " 2>/dev/null || true")
    if str_len(str_trim_space(probe)) > 0 {
        return 1
    }
    return 0
}

// Native cert expiry parsing is intentionally not shell-backed. Returns "" if unknown.
fn acme_cert_not_after(cert_path: string) -> string {
    if str_eq(cert_path, "") { return "" }
    if not file_exists(cert_path) { return "" }
    return ""
}

// Preflight for issue: returns empty string if OK, else human + machine-friendly error.
// Format: "code=CODE message=..." for API consumers.
fn acme_preflight_issue(settings: AcmeSettings, domain: string, email_override: string) -> string {
    if acme_token_safe(domain) == 0 {
        return "code=invalid_domain message=domain must be a safe hostname (letters, digits, . - _)"
    }
    if not str_eq(settings.helper, "native") {
        if acme_token_safe(settings.helper) == 0 {
            return "code=invalid_helper message=acme_helper path/name contains unsafe characters"
        }
        if acme_helper_available(settings.helper) == 0 {
            return "code=missing_helper message=legacy ACME helper not found on PATH — use native mode or set LEBA_ACME_HELPER"
        }
    }
    let mut email = email_override
    if str_eq(email, "") {
        email = settings.email
    }
    if acme_email_ok(email) == 0 {
        return "code=missing_email message=valid email required — set defaults acme_email, LEBA_ACME_EMAIL, or query email="
    }
    if acme_token_safe(settings.webroot) == 0 {
        return "code=invalid_webroot message=acme_webroot path is empty or unsafe"
    }
    if acme_token_safe(settings.storage) == 0 {
        return "code=invalid_storage message=acme_storage path is empty or unsafe"
    }
    return ""
}

fn acme_preflight_renew(settings: AcmeSettings) -> string {
    if acme_token_safe(settings.helper) == 0 {
        return "code=invalid_helper message=acme_helper path/name contains unsafe characters"
    }
    if acme_helper_available(settings.helper) == 0 {
        return "code=missing_helper message=legacy ACME helper not found — use native mode or set LEBA_ACME_HELPER"
    }
    if acme_token_safe(settings.storage) == 0 {
        return "code=invalid_storage message=acme_storage path is empty or unsafe"
    }
    let certs_dir = settings.storage + "/certificates"
    if not file_exists(certs_dir) {
        return "code=no_certs message=no certificates directory under acme_storage — issue a cert first"
    }
    return ""
}

fn acme_error_json(err: string) -> string {
    // Parse "code=X message=Y" into structured JSON; else plain error.
    let mut code = ""
    let mut message = err
    if str_has_prefix(err, "code=") {
        let rest = substr(err, 5, str_len(err))
        let cut = str_index(rest, " message=")
        if cut >= 0 {
            code = substr(rest, 0, cut)
            message = substr(rest, cut + 9, str_len(rest))
        } else {
            code = rest
            message = err
        }
    }
    let mut b = str_builder()
    builder_write(b, "{\"error\":\"")
    builder_write(b, json_escape(message))
    builder_write(b, "\"")
    if not str_eq(code, "") {
        builder_write(b, ",\"code\":\"")
        builder_write(b, json_escape(code))
        builder_write(b, "\"")
    }
    builder_write(b, "}\n")
    return builder_string(b)
}

fn acme_preflight_http_status(err: string) -> int {
    if str_has_prefix(err, "code=missing_helper") {
        return 400
    }
    if str_has_prefix(err, "code=missing_email") {
        return 400
    }
    if str_has_prefix(err, "code=missing_dns_provider") {
        return 400
    }
    if str_has_prefix(err, "code=invalid_") {
        return 400
    }
    if str_has_prefix(err, "code=no_certs") {
        return 400
    }
    return 500
}


fn acme_storage_dir(settings: AcmeSettings, name: string) -> string {
    return settings.storage + "/" + name
}

fn acme_account_key_path(settings: AcmeSettings) -> string {
    return acme_storage_dir(settings, "accounts/account-p256.key")
}

fn acme_account_url_path(settings: AcmeSettings) -> string {
    return acme_storage_dir(settings, "accounts/account.url")
}

fn acme_safe_mkdirs(settings: AcmeSettings) -> int {
    if acme_token_safe(settings.storage) == 0 {
        return 0
    }
    let _ = mkdir(settings.storage)
    let _ = mkdir(settings.storage + "/accounts")
    let _ = mkdir(settings.storage + "/certificates")
    if not str_eq(settings.webroot, "") {
        let _ = mkdir(settings.webroot)
    }
    return 1
}

fn acme_native_account_key(settings: AcmeSettings) -> string {
    if acme_safe_mkdirs(settings) == 0 {
        return ""
    }
    let path = acme_account_key_path(settings)
    if not file_exists(path) {
        if p256_keygen(path) != 0 {
            return ""
        }
    }
    return read_file(path)
}

fn acme_compact_part(token: string, idx: int) -> string {
    let p1 = str_index(token, ".")
    if p1 < 0 { return "" }
    if idx == 0 { return substr(token, 0, p1) }
    let rest = substr(token, p1 + 1, str_len(token))
    let p2 = str_index(rest, ".")
    if p2 < 0 { return "" }
    if idx == 1 { return substr(rest, 0, p2) }
    if idx == 2 { return substr(rest, p2 + 1, str_len(rest)) }
    return ""
}

fn acme_jws_json(url: string, nonce: string, kid: string, key_pem: string, payload: string) -> string {
    let mut header = str_builder()
    builder_write(header, "{\"alg\":\"ES256\",\"nonce\":\"")
    builder_write(header, json_escape(nonce))
    builder_write(header, "\",\"url\":\"")
    builder_write(header, json_escape(url))
    builder_write(header, "\",")
    if str_eq(kid, "") {
        let jwk = p256_public_jwk(key_pem)
        if str_eq(jwk, "") { return "" }
        builder_write(header, "\"jwk\":")
        builder_write(header, jwk)
    } else {
        builder_write(header, "\"kid\":\"")
        builder_write(header, json_escape(kid))
        builder_write(header, "\"")
    }
    builder_write(header, "}")
    let compact = jwt_sign_es256_header(payload, key_pem, builder_string(header))
    let protected = acme_compact_part(compact, 0)
    let pay = acme_compact_part(compact, 1)
    let sig = acme_compact_part(compact, 2)
    if str_eq(protected, "") or str_eq(sig, "") { return "" }
    let mut out = str_builder()
    builder_write(out, "{\"protected\":\"")
    builder_write(out, protected)
    builder_write(out, "\",\"payload\":\"")
    builder_write(out, pay)
    builder_write(out, "\",\"signature\":\"")
    builder_write(out, sig)
    builder_write(out, "\"}")
    return builder_string(out)
}

fn acme_post_jws(url: string, nonce: string, kid: string, key_pem: string, payload: string) -> string {
    let body = acme_jws_json(url, nonce, kid, key_pem, payload)
    if str_eq(body, "") { return "" }
    return https_post(url, body, "application/jose+json", "", 30000)
}

fn acme_next_nonce(new_nonce_url: string) -> string {
    let _ = https_get(new_nonce_url, "", 15000)
    return https_last_header("Replay-Nonce")
}

fn acme_json_first_array_string(json: string, key: string) -> string {
    let needle = "\"" + key + "\":[\""
    let i = str_index(json, needle)
    if i < 0 { return "" }
    let start = i + str_len(needle)
    let rest = substr(json, start, str_len(json))
    let e = str_index(rest, "\"")
    if e < 0 { return "" }
    return substr(rest, 0, e)
}

fn acme_json_string_after(json: string, marker: string, key: string) -> string {
    let mi = str_index(json, marker)
    if mi < 0 { return "" }
    let tail = substr(json, mi, str_len(json))
    let needle = "\"" + key + "\":\""
    let ki = str_index(tail, needle)
    if ki < 0 { return "" }
    let start = ki + str_len(needle)
    let rest = substr(tail, start, str_len(tail))
    let e = str_index(rest, "\"")
    if e < 0 { return "" }
    return substr(rest, 0, e)
}

fn acme_http01_url(authz: string) -> string {
    return acme_json_string_after(authz, "\"type\":\"http-01\"", "url")
}

fn acme_http01_token(authz: string) -> string {
    return acme_json_string_after(authz, "\"type\":\"http-01\"", "token")
}


fn acme_pem_block_der_b64url(pem: string, begin: string, finish: string) -> string {
    let bi = str_index(pem, begin)
    if bi < 0 { return "" }
    let tail = substr(pem, bi + str_len(begin), str_len(pem))
    let ei = str_index(tail, finish)
    if ei < 0 { return "" }
    let mut body = substr(tail, 0, ei)
    body = str_replace(body, "\r", "")
    body = str_replace(body, "\n", "")
    body = str_replace(body, " ", "")
    if str_eq(body, "") { return "" }
    return base64url_encode(base64_decode(body))
}

fn acme_csr_der_b64url(csr_pem: string) -> string {
    return acme_pem_block_der_b64url(csr_pem, "-----BEGIN CERTIFICATE REQUEST-----", "-----END CERTIFICATE REQUEST-----")
}

fn acme_native_issue_http(settings: AcmeSettings, domain: string, email_override: string) -> AcmeRunResult {
    let pre = acme_preflight_issue(settings, domain, email_override)
    if not str_eq(pre, "") {
        return AcmeRunResult { ok: 0, error: pre, cert: "", key: "", domain: domain, output: "" }
    }
    let key_pem = acme_native_account_key(settings)
    if str_eq(key_pem, "") {
        return AcmeRunResult { ok: 0, error: "code=account_key_failed message=failed to generate native P-256 ACME account key", cert: "", key: "", domain: domain, output: "" }
    }
    let directory = https_get(acme_effective_server(settings), "", 30000)
    if https_last_status() < 200 or https_last_status() >= 300 {
        return AcmeRunResult { ok: 0, error: "code=directory_failed message=failed to fetch ACME directory", cert: "", key: "", domain: domain, output: directory }
    }
    let new_nonce = json_get_string(directory, "newNonce")
    let new_account = json_get_string(directory, "newAccount")
    let new_order = json_get_string(directory, "newOrder")
    if str_eq(new_nonce, "") or str_eq(new_account, "") or str_eq(new_order, "") {
        return AcmeRunResult { ok: 0, error: "code=directory_invalid message=ACME directory missing required endpoints", cert: "", key: "", domain: domain, output: directory }
    }
    let mut email = email_override
    if str_eq(email, "") { email = settings.email }
    let mut kid = str_trim_space(read_file(acme_account_url_path(settings)))
    let mut nonce = acme_next_nonce(new_nonce)
    if str_eq(nonce, "") {
        return AcmeRunResult { ok: 0, error: "code=nonce_failed message=ACME server did not return Replay-Nonce", cert: "", key: "", domain: domain, output: "" }
    }
    if str_eq(kid, "") {
        let acct_payload = "{\"termsOfServiceAgreed\":true,\"contact\":[\"mailto:" + email + "\"]}"
        let acct = acme_post_jws(new_account, nonce, "", key_pem, acct_payload)
        let st = https_last_status()
        if st < 200 or st >= 300 {
            return AcmeRunResult { ok: 0, error: "code=account_failed message=ACME account creation failed", cert: "", key: "", domain: domain, output: acct }
        }
        kid = https_last_header("Location")
        if str_eq(kid, "") {
            return AcmeRunResult { ok: 0, error: "code=account_location_missing message=ACME account response missing Location", cert: "", key: "", domain: domain, output: acct }
        }
        let _ = atomic_write_file(acme_account_url_path(settings), kid + "\n")
        nonce = https_last_header("Replay-Nonce")
    }
    if str_eq(nonce, "") { nonce = acme_next_nonce(new_nonce) }
    let order_payload = "{\"identifiers\":[{\"type\":\"dns\",\"value\":\"" + domain + "\"}]}"
    let order = acme_post_jws(new_order, nonce, kid, key_pem, order_payload)
    let order_url = https_last_header("Location")
    nonce = https_last_header("Replay-Nonce")
    if https_last_status() < 200 or https_last_status() >= 300 {
        return AcmeRunResult { ok: 0, error: "code=order_failed message=ACME order creation failed", cert: "", key: "", domain: domain, output: order }
    }
    let authz_url = acme_json_first_array_string(order, "authorizations")
    let finalize_url = json_get_string(order, "finalize")
    if str_eq(authz_url, "") or str_eq(finalize_url, "") or str_eq(order_url, "") {
        return AcmeRunResult { ok: 0, error: "code=order_invalid message=ACME order missing authorization/finalize URL", cert: "", key: "", domain: domain, output: order }
    }
    if str_eq(nonce, "") { nonce = acme_next_nonce(new_nonce) }
    let authz = acme_post_jws(authz_url, nonce, kid, key_pem, "")
    nonce = https_last_header("Replay-Nonce")
    if https_last_status() < 200 or https_last_status() >= 300 {
        return AcmeRunResult { ok: 0, error: "code=authz_failed message=failed to fetch ACME authorization", cert: "", key: "", domain: domain, output: authz }
    }
    let chall_url = acme_http01_url(authz)
    let token = acme_http01_token(authz)
    if str_eq(chall_url, "") or str_eq(token, "") {
        return AcmeRunResult { ok: 0, error: "code=http01_missing message=ACME authorization missing http-01 challenge", cert: "", key: "", domain: domain, output: authz }
    }
    let thumb = p256_jwk_thumbprint(key_pem)
    if str_eq(thumb, "") {
        return AcmeRunResult { ok: 0, error: "code=thumbprint_failed message=failed to compute account key thumbprint", cert: "", key: "", domain: domain, output: "" }
    }
    let keyauth = token + "." + thumb
    let _ = write_file(settings.webroot + "/" + token, keyauth)
    if str_eq(nonce, "") { nonce = acme_next_nonce(new_nonce) }
    let chall = acme_post_jws(chall_url, nonce, kid, key_pem, "{}")
    nonce = https_last_header("Replay-Nonce")
    if https_last_status() < 200 or https_last_status() >= 300 {
        return AcmeRunResult { ok: 0, error: "code=challenge_failed message=ACME challenge trigger failed", cert: "", key: "", domain: domain, output: chall }
    }
    let mut valid = 0
    let mut last_authz = chall
    let mut poll = 0
    while poll < 20 {
        sleep_ms(1000)
        if str_eq(nonce, "") { nonce = acme_next_nonce(new_nonce) }
        last_authz = acme_post_jws(authz_url, nonce, kid, key_pem, "")
        nonce = https_last_header("Replay-Nonce")
        if str_contains(last_authz, "\"status\":\"valid\"") {
            valid = 1
            break
        }
        if str_contains(last_authz, "\"status\":\"invalid\"") {
            break
        }
        poll = poll + 1
    }
    if valid == 0 {
        return AcmeRunResult { ok: 0, error: "code=challenge_not_valid message=HTTP-01 challenge did not become valid", cert: "", key: "", domain: domain, output: last_authz }
    }
    let cert, cert_key = acme_cert_paths(settings.storage, domain)
    let csr = settings.storage + "/certificates/" + domain + ".csr"
    if tls_make_csr(csr, cert_key, domain, 2048) != 0 {
        return AcmeRunResult { ok: 0, error: "code=csr_failed message=failed to create CSR/key PEM", cert: cert, key: cert_key, domain: domain, output: "" }
    }
    let csr_der = acme_csr_der_b64url(read_file(csr))
    if str_eq(csr_der, "") {
        return AcmeRunResult { ok: 0, error: "code=csr_encoding_failed message=failed to DER/base64url encode CSR", cert: cert, key: cert_key, domain: domain, output: "" }
    }
    let csr_payload = "{\"csr\":\"" + csr_der + "\"}"
    if str_eq(nonce, "") { nonce = acme_next_nonce(new_nonce) }
    let fin = acme_post_jws(finalize_url, nonce, kid, key_pem, csr_payload)
    nonce = https_last_header("Replay-Nonce")
    if https_last_status() < 200 or https_last_status() >= 300 {
        return AcmeRunResult { ok: 0, error: "code=finalize_failed message=ACME finalize failed", cert: cert, key: cert_key, domain: domain, output: fin }
    }
    let mut cert_url = json_get_string(fin, "certificate")
    let mut order_body = fin
    let mut opoll = 0
    while str_eq(cert_url, "") and opoll < 20 {
        sleep_ms(1000)
        if str_eq(nonce, "") { nonce = acme_next_nonce(new_nonce) }
        order_body = acme_post_jws(order_url, nonce, kid, key_pem, "")
        nonce = https_last_header("Replay-Nonce")
        cert_url = json_get_string(order_body, "certificate")
        opoll = opoll + 1
    }
    if str_eq(cert_url, "") {
        return AcmeRunResult { ok: 0, error: "code=certificate_missing message=ACME order did not expose certificate URL", cert: cert, key: cert_key, domain: domain, output: order_body }
    }
    if str_eq(nonce, "") { nonce = acme_next_nonce(new_nonce) }
    let pem = acme_post_jws(cert_url, nonce, kid, key_pem, "")
    if https_last_status() < 200 or https_last_status() >= 300 or not str_contains(pem, "BEGIN CERTIFICATE") {
        return AcmeRunResult { ok: 0, error: "code=certificate_download_failed message=failed to download issued certificate", cert: cert, key: cert_key, domain: domain, output: pem }
    }
    let _ = atomic_write_file(cert, pem)
    return acme_issue_finish(settings, domain, pem, "http")
}

// challenge: "http" (default) or "dns". dns_provider e.g. cloudflare, route53, digitalocean.
// DNS credentials come from provider-standard env vars (CF_DNS_API_TOKEN, AWS_*, etc.).
fn acme_issue(settings: AcmeSettings, domain: string, email_override: string) -> AcmeRunResult {
    return acme_issue_challenge(settings, domain, email_override, "http", "")
}

fn acme_issue_challenge(
    settings: AcmeSettings,
    domain: string,
    email_override: string,
    challenge: string,
    dns_provider: string
) -> AcmeRunResult {
    let mut ch0 = challenge
    if str_eq(ch0, "") {
        ch0 = "http"
    }
    if str_eq(settings.helper, "native") {
        if str_eq(ch0, "http") {
            return acme_native_issue_http(settings, domain, email_override)
        }
        return AcmeRunResult { ok: 0, error: "code=native_dns_unsupported message=native ACME currently supports HTTP-01; DNS-01 provider adapters are not enabled", cert: "", key: "", domain: domain, output: "" }
    }
    let pre = acme_preflight_issue(settings, domain, email_override)
    if not str_eq(pre, "") {
        return AcmeRunResult { ok: 0, error: pre, cert: "", key: "", domain: domain, output: "" }
    }
    let mut email = email_override
    if str_eq(email, "") {
        email = settings.email
    }
    let mut ch = challenge
    if str_eq(ch, "") {
        ch = "http"
    }
    if str_eq(ch, "dns") {
        let mut prov = dns_provider
        if str_eq(prov, "") {
            prov = env_get_or("LEBA_ACME_DNS_PROVIDER", "")
        }
        if str_eq(prov, "") {
            return AcmeRunResult {
                ok: 0,
                error: "code=missing_dns_provider message=DNS-01 requires dns_provider= or LEBA_ACME_DNS_PROVIDER (e.g. cloudflare)",
                cert: "",
                key: "",
                domain: domain,
                output: ""
            }
        }
        if acme_token_safe(prov) == 0 {
            return AcmeRunResult {
                ok: 0,
                error: "code=invalid_dns_provider message=dns provider name is unsafe",
                cert: "",
                key: "",
                domain: domain,
                output: ""
            }
        }
        let _ = exec_run("mkdir -p " + settings.storage + " " + settings.storage + "/certificates")
        let mut cmd = str_builder()
        builder_write(cmd, settings.helper)
        builder_write(cmd, " --accept-tos --email ")
        builder_write(cmd, email)
        builder_write(cmd, " --dns ")
        builder_write(cmd, prov)
        builder_write(cmd, " --path ")
        builder_write(cmd, settings.storage)
        builder_write(cmd, " --domains ")
        builder_write(cmd, domain)
        let with_server = acme_append_server_flag(builder_string(cmd), settings)
        let full = with_server + " run 2>&1"
        let ca = acme_ca_name(settings)
        log_info_event("acme_issue_start", f"domain={domain} challenge=dns provider={prov} ca={ca} server={acme_effective_server(settings)}")
        let out = exec_output(full)
        return acme_issue_finish(settings, domain, out, "dns")
    }
    // HTTP-01 default → Let's Encrypt production (or staging / custom ACME directory)
    let _ = exec_run("mkdir -p " + settings.webroot + " " + settings.storage + " " + settings.storage + "/certificates")
    let mut cmdh = str_builder()
    builder_write(cmdh, settings.helper)
    builder_write(cmdh, " --accept-tos --email ")
    builder_write(cmdh, email)
    builder_write(cmdh, " --http --http.webroot ")
    builder_write(cmdh, settings.webroot)
    builder_write(cmdh, " --path ")
    builder_write(cmdh, settings.storage)
    builder_write(cmdh, " --domains ")
    builder_write(cmdh, domain)
    let with_server_h = acme_append_server_flag(builder_string(cmdh), settings)
    let full_h = with_server_h + " run 2>&1"
    let ca_h = acme_ca_name(settings)
    log_info_event("acme_issue_start", f"domain={domain} helper={settings.helper} challenge=http ca={ca_h} server={acme_effective_server(settings)}")
    let out = exec_output(full_h)
    return acme_issue_finish(settings, domain, out, "http")
}

fn acme_issue_finish(settings: AcmeSettings, domain: string, out: string, challenge: string) -> AcmeRunResult {
    let cert, key = acme_cert_paths(settings.storage, domain)
    if acme_paths_exist(cert, key) == 1 {
        log_info_event("acme_issue_ok", f"domain={domain} cert={cert} challenge={challenge}")
        return AcmeRunResult { ok: 1, error: "", cert: cert, key: key, domain: domain, output: out }
    }
    let mut err = "code=acme_failed message=ACME did not produce certificate files under acme_storage/certificates/"
    if str_len(out) > 0 {
        let mut snippet = out
        if str_len(snippet) > 400 {
            snippet = substr(snippet, 0, 400)
        }
        err = "code=acme_failed message=" + snippet
    }
    log_warn_event("acme_issue_failed", f"domain={domain} err={err}")
    return AcmeRunResult { ok: 0, error: err, cert: cert, key: key, domain: domain, output: out }
}

fn acme_renew(settings: AcmeSettings) -> AcmeRunResult {
    if str_eq(settings.helper, "native") {
        let certs_dir = settings.storage + "/certificates"
        if not file_exists(certs_dir) {
            return AcmeRunResult { ok: 0, error: "code=no_certs message=no certificates directory under acme_storage — issue a cert first", cert: "", key: "", domain: "", output: "" }
        }
        let entries = read_dir(certs_dir)
        let mut renewed = 0
        let mut last = AcmeRunResult { ok: 1, error: "", cert: "", key: "", domain: "", output: "" }
        for _, name in range entries {
            if str_has_suffix(name, ".crt") {
                let domain = substr(name, 0, str_len(name) - 4)
                let r = acme_native_issue_http(settings, domain, "")
                last = r
                if r.ok == 0 { return r }
                renewed = renewed + 1
            }
        }
        if renewed == 0 {
            return AcmeRunResult { ok: 0, error: "code=no_certs message=no certificate PEMs under acme_storage", cert: "", key: "", domain: "", output: "" }
        }
        log_info_event("acme_renew_done", f"storage={settings.storage} renewed={renewed}")
        return last
    }
    let pre = acme_preflight_renew(settings)
    if not str_eq(pre, "") {
        return AcmeRunResult { ok: 0, error: pre, cert: "", key: "", domain: "", output: "" }
    }
    let mut cmd = str_builder()
    builder_write(cmd, settings.helper)
    builder_write(cmd, " --path ")
    builder_write(cmd, settings.storage)
    let with_server = acme_append_server_flag(builder_string(cmd), settings)
    let full = with_server + " renew --no-random-sleep 2>&1"
    let ca = acme_ca_name(settings)
    log_info_event("acme_renew_start", f"storage={settings.storage} ca={ca} server={acme_effective_server(settings)} helper=legacy")
    let out = exec_output(full)
    let certs_dir = settings.storage + "/certificates"
    if file_exists(certs_dir) {
        log_info_event("acme_renew_done", f"storage={settings.storage}")
        return AcmeRunResult { ok: 1, error: "", cert: "", key: "", domain: "", output: out }
    }
    return AcmeRunResult { ok: 0, error: "code=renew_failed message=renew finished but certificates directory missing", cert: "", key: "", domain: "", output: out }
}

fn acme_list_json(frontends: []Frontend, settings: AcmeSettings) -> string {
    let mut b = str_builder()
    builder_write(b, "{\"certificates\":[")
    let mut first = 1
    for _, fe in range frontends {
        if not str_eq(fe.tls_cert, "") {
            if first == 0 {
                builder_write(b, ",")
            }
            first = 0
            builder_write(b, "{\"source\":\"frontend\",\"frontend\":\"")
            builder_write(b, json_escape(fe.name))
            builder_write(b, "\",\"hostname\":\"\",\"cert\":\"")
            builder_write(b, json_escape(fe.tls_cert))
            builder_write(b, "\",\"key\":\"")
            builder_write(b, json_escape(fe.tls_key))
            builder_write(b, "\",\"exists\":")
            if acme_paths_exist(fe.tls_cert, fe.tls_key) == 1 {
                builder_write(b, "true")
            } else {
                builder_write(b, "false")
            }
            builder_write(b, ",\"not_after\":\"")
            builder_write(b, json_escape(acme_cert_not_after(fe.tls_cert)))
            builder_write(b, "\"}")
        }
        for _, se in range fe.tls_sni {
            if first == 0 {
                builder_write(b, ",")
            }
            first = 0
            builder_write(b, "{\"source\":\"sni\",\"frontend\":\"")
            builder_write(b, json_escape(fe.name))
            builder_write(b, "\",\"hostname\":\"")
            builder_write(b, json_escape(se.hostname))
            builder_write(b, "\",\"cert\":\"")
            builder_write(b, json_escape(se.cert))
            builder_write(b, "\",\"key\":\"")
            builder_write(b, json_escape(se.key))
            builder_write(b, "\",\"exists\":")
            if acme_paths_exist(se.cert, se.key) == 1 {
                builder_write(b, "true")
            } else {
                builder_write(b, "false")
            }
            builder_write(b, ",\"not_after\":\"")
            builder_write(b, json_escape(acme_cert_not_after(se.cert)))
            builder_write(b, "\"}")
        }
    }
    let certs_dir = settings.storage + "/certificates"
    if file_exists(certs_dir) {
        let entries = read_dir(certs_dir)
        for _, name in range entries {
            if str_has_suffix(name, ".crt") {
                let domain = substr(name, 0, str_len(name) - 4)
                let cert, key = acme_cert_paths(settings.storage, domain)
                if first == 0 {
                    builder_write(b, ",")
                }
                first = 0
                builder_write(b, "{\"source\":\"native\",\"frontend\":\"\",\"hostname\":\"")
                builder_write(b, json_escape(domain))
                builder_write(b, "\",\"cert\":\"")
                builder_write(b, json_escape(cert))
                builder_write(b, "\",\"key\":\"")
                builder_write(b, json_escape(key))
                builder_write(b, "\",\"exists\":")
                if acme_paths_exist(cert, key) == 1 {
                    builder_write(b, "true")
                } else {
                    builder_write(b, "false")
                }
                builder_write(b, ",\"not_after\":\"")
                builder_write(b, json_escape(acme_cert_not_after(cert)))
                builder_write(b, "\"}")
            }
        }
    }
    let mut helper_ok = acme_helper_available(settings.helper)
    if str_eq(settings.helper, "native") { helper_ok = 1 }
    let email_ok = acme_email_ok(settings.email)
    builder_write(b, "],\"settings\":{\"provider\":\"letsencrypt\",\"ca\":\"")
    builder_write(b, json_escape(acme_ca_name(settings)))
    builder_write(b, "\",\"server\":\"")
    builder_write(b, json_escape(acme_effective_server(settings)))
    builder_write(b, "\",\"staging\":")
    if settings.staging == 1 {
        builder_write(b, "true")
    } else {
        builder_write(b, "false")
    }
    builder_write(b, ",\"webroot\":\"")
    builder_write(b, json_escape(settings.webroot))
    builder_write(b, "\",\"storage\":\"")
    builder_write(b, json_escape(settings.storage))
    builder_write(b, "\",\"email\":\"")
    builder_write(b, json_escape(settings.email))
    builder_write(b, "\",\"helper\":\"")
    builder_write(b, json_escape(settings.helper))
    builder_write(b, "\",\"helper_available\":")
    if helper_ok == 1 {
        builder_write(b, "true")
    } else {
        builder_write(b, "false")
    }
    builder_write(b, ",\"email_configured\":")
    if email_ok == 1 {
        builder_write(b, "true")
    } else {
        builder_write(b, "false")
    }
    builder_write(b, ",\"ready\":")
    if helper_ok == 1 {
        if email_ok == 1 {
            builder_write(b, "true")
        } else {
            builder_write(b, "false")
        }
    } else {
        builder_write(b, "false")
    }
    builder_write(b, ",\"issues\":[")
    let mut ifirst = 1
    if helper_ok == 0 {
        builder_write(b, "{\"code\":\"missing_helper\",\"message\":\"Use native ACME or set LEBA_ACME_HELPER\"}")
        ifirst = 0
    }
    if email_ok == 0 {
        if ifirst == 0 {
            builder_write(b, ",")
        }
        builder_write(b, "{\"code\":\"missing_email\",\"message\":\"Set LEBA_ACME_EMAIL or defaults acme_email\"}")
        ifirst = 0
    }
    if acme_token_safe(settings.webroot) == 0 {
        if ifirst == 0 {
            builder_write(b, ",")
        }
        builder_write(b, "{\"code\":\"invalid_webroot\",\"message\":\"acme_webroot empty or unsafe\"}")
    }
    builder_write(b, "]}}\n")
    return builder_string(b)
}
